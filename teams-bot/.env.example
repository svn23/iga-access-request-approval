# ====================
# Core Configuration
# ====================
HOST=0.0.0.0
PORT=8000

# ====================
# Teams Bot
# ====================
TEAMS_APP_ID=your-teams-app-id
TEAMS_APP_PASSWORD=your-teams-app-password
TEAMS_APP_TENANT_ID=your-tenant-id
BOT_NAME=AccessMate

# ====================
# Database
# ====================
SQLITE_DB_PATH=data/accessmate.sqlite3

# ====================
# MidPoint Java API
# ====================
MIDPOINT_BASE_URL=https://your-midpoint-host:8443
MIDPOINT_API_TOKEN=your_bot_connector_api_token
CATALOG_SYNC_MINUTES=30
MIDPOINT_TLS_VERIFY=true

# Fallback Bot Framework serviceUrl for proactive DMs triggered by inbound
# midPoint notifications (POST /api/notify). Region-stable per Teams cloud.
# Leave blank to rely solely on the most recent serviceUrl seen per user.
TEAMS_SERVICE_URL=https://smba.trafficmanager.net/in/

# ====================
# Provisioning Mode
# ====================
# Options: midpoint | mcp | disabled
PROVISIONING_MODE=midpoint

# ====================
# AI Configuration (Optional)
# ====================
# Set to true to enable AI-powered features (intent parsing, parameter extraction, conversational responses)
# Set to false to use hardcoded rules and static responses (API-only mode)
ENABLE_AI=false

# AI Provider (only used if ENABLE_AI=true)
# Options: gemini | openai | anthropic | groq
LLM_PROVIDER=gemini
LLM_MODEL=

# API Keys (only required if ENABLE_AI=true and using that provider)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_API_BASE=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# ====================
# Activity Limits
# ====================
MAX_ACTIVITY_BYTES=65536
VALIDATE_BOT_AUTH=true
ALLOW_UNAUTHENTICATED_DEV=false

# ====================
# Conversation state / interaction security
# ====================
SESSION_TIMEOUT_MINUTES=30
PROCESSING_TIMEOUT_SECONDS=60
MAX_PROCESSING_SECONDS=120
DEDUP_WINDOW_SECONDS=300
GREETING_KEYWORDS=hi,hello,hey,start

# Bot Framework SDK path for /api/messages (adapter + TurnContext I/O). Default false = raw REST.
USE_BOT_FRAMEWORK_SDK=false

# Manager notification: midpoint (midPoint notifiers → /notify → bot) | bot (bot resolves + DMs).
MANAGER_NOTIFY_MODE=midpoint

# Require a comment when a manager rejects (audit trail + requester learns why). true keeps the card
# live and asks for a reason; false allows one-click rejects with no comment.
REQUIRE_REJECT_COMMENT=true

# Fallback approver DM'd when a requester has no line manager in midPoint (org:manager unset) or is
# their own manager (self-approval). Blank → requester is told no approver is configured; request waits.
FALLBACK_APPROVER_EMAIL=
# Master switch for bot-driven approval DMs (manager card + requester outcome). Keep true while the
# midPoint push notifier is a non-firing blocker. Set false once the notifier delivers reliably, so
# the notifier is the sole path and there is no double-notification.
BOT_DIRECT_NOTIFY=true

# --- Zero-touch proactive delivery via Microsoft Graph -------------------------------------------
# When true, a recipient whose real Teams id is unknown is resolved via Graph: email → Entra user →
# the bot app is proactively installed for them → their 1:1 chat id is used to DM them. No prior
# interaction with the bot required. Falls back to the learned-id path when false or on failure.
# Requires ADMIN-CONSENTED application Graph permissions on app 917722f2…:
#   User.Read.All, TeamsAppInstallation.ReadWriteForUser.All, AppCatalog.Read.All
GRAPH_PROACTIVE_ENABLED=false
# Graph token targets the REAL directory tenant (NOT botframework.com). Same app id/secret as the bot.
GRAPH_TENANT_ID=
# The bot's app id IN THE ORG TEAMS APP CATALOG (Teams admin center → Manage apps → your app →
# copy the App ID). This is NOT the bot/client id (917722f2…). Required for GRAPH_PROACTIVE_ENABLED.
TEAMS_CATALOG_APP_ID=
# midPoint is the source of truth: its payloads overwrite the bot's local identity cache.
MIDPOINT_AUTHORITATIVE=true
